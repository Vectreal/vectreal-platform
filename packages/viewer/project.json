{
	"name": "vctrl/viewer",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/viewer/src",
	"projectType": "library",
	"tags": [],
	"targets": {
		"lint": {
			"executor": "@nx/eslint:lint",
			"outputs": ["{options.outputFile}"],
			"options": {
				"fix": true,
				"lintFilePatterns": [
					"packages/viewer/src/**/*.{ts,tsx,js,jsx}",
					"packages/viewer/vite.config.ts",
					"packages/viewer/package.json"
				]
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"outputs": [],
			"options": {
				"command": "tsc --noEmit -p packages/viewer/tsconfig.json"
			}
		},
		"publish": {
			"dependsOn": ["prepare-publish"],
			"executor": "nx:run-commands",
			"outputs": [],
			"options": {
				"command": "pnpm publish --no-git-checks --access public",
				"cwd": "build/packages/vctrl/viewer"
			}
		},
		"copy-md": {
			"dependsOn": ["build"],
			"executor": "nx:run-commands",
			"outputs": [],
			"options": {
				"commands": [
					"rsync -rat packages/viewer/*.md build/packages/vctrl/viewer/"
				]
			}
		},
		"prepare-publish": {
			"dependsOn": ["copy-md"],
			"executor": "nx:run-commands",
			"outputs": [],
			"options": {
				"command": "node tools/publish/rewrite-manifest.mjs --dir build/packages/vctrl/viewer"
			}
		},
		"build": {
			"executor": "@nx/vite:build",
			"outputs": ["{options.outputPath}"],
			"options": {
				"outputPath": "build/packages/vctrl/viewer",
				"configFile": "packages/viewer/vite.config.ts"
			}
		},
		"build-ci": {
			"executor": "@nx/vite:build",
			"outputs": ["{options.outputPath}"],
			"options": {
				"outputPath": "build/packages/vctrl/viewer",
				"configFile": "packages/viewer/vite.config.ts"
			}
		},
		"typecheck-storybook": {
			"executor": "nx:run-commands",
			"outputs": [],
			"options": {
				"command": "tsc --noEmit -p packages/viewer/tsconfig.storybook.json"
			}
		}
	}
}
