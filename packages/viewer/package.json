{
	"version": "1.0.0",
	"name": "@vctrl/viewer",
	"description": "vctrl/viewer is a React component library for rendering and interacting with 3D models. It's part of the vectreal ecosystem and is designed to work seamlessly with the vctrl/hooks package for model loading and management.",
	"bugs": {
		"url": "https://github.com/Vectreal/vectreal-platform/issues"
	},
	"homepage": "https://vectreal.com",
	"keywords": [
		"vectreal",
		"react",
		"3d",
		"model",
		"viewer",
		"react-component",
		"react-three-fiber",
		"react-three-drei",
		"threejs",
		"react-three-gltf",
		"gltf",
		"glb",
		"usdz",
		"model-viewer"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Vectreal/vectreal-platform.git"
	},
	"license": "AGPL-3.0-only",
	"main": "./index.js",
	"module": "./index.js",
	"types": "./index.d.ts",
	"type": "module",
	"publishConfig": {
		"access": "public",
		"directory": "../../build/packages/vctrl/viewer"
	},
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.js",
			"require": "./index.cjs"
		},
		"./hotspots": {
			"types": "./hotspots.d.ts",
			"import": "./hotspots.js",
			"require": "./hotspots.cjs"
		},
		"./css": "./style.css"
	},
	"dependencies": {
		"@react-three/drei": "catalog:",
		"@react-three/fiber": "catalog:",
		"@react-three/postprocessing": "catalog:",
		"postprocessing": "catalog:"
	},
	"peerDependencies": {
		"three": "catalog:",
		"react": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@vctrl/core": "workspace:*",
		"@shared/components": "workspace:*",
		"@shared/utils": "workspace:*"
	}
}
