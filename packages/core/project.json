{
	"name": "vctrl/core",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "packages/core/src",
	"projectType": "library",
	"tags": [],
	"targets": {
		"lint": {
			"executor": "@nx/eslint:lint",
			"outputs": [
				"{options.outputFile}"
			],
			"options": {
				"lintFilePatterns": [
					"packages/core/**/*.{ts,tsx,js,jsx}",
					"packages/core/package.json"
				]
			}
		},
		"lint-fix": {
			"executor": "@nx/eslint:lint",
			"outputs": [
				"{options.outputFile}"
			],
			"options": {
				"fix": true,
				"lintFilePatterns": [
					"packages/core/**/*.{ts,tsx,js,jsx}",
					"packages/core/package.json"
				]
			}
		},
		"typecheck": {
			"executor": "nx:run-commands",
			"outputs": [],
			"options": {
				"cwd": "packages/core",
				"command": "tsc --noEmit -p tsconfig.lib.json && tsc --noEmit -p tsconfig.spec.json"
			}
		},
		"build": {
			"executor": "@nx/vite:build",
			"outputs": [
				"{options.outputPath}"
			],
			"defaultConfiguration": "production",
			"options": {
				"outputPath": "build/packages/vctrl/core"
			},
			"configurations": {
				"development": {
					"mode": "development"
				},
				"production": {
					"mode": "production"
				}
			}
		},
		"build-ci": {
			"executor": "@nx/vite:build",
			"outputs": [
				"{options.outputPath}"
			],
			"defaultConfiguration": "production",
			"options": {
				"outputPath": "build/packages/vctrl/core"
			},
			"configurations": {
				"development": {
					"mode": "development"
				},
				"production": {
					"mode": "production"
				}
			}
		},
		"publish": {
			"dependsOn": [
				"copy-md"
			],
			"executor": "nx:run-commands",
			"outputs": [],
			"options": {
				"command": "pnpm publish --no-git-checks --access public",
				"cwd": "packages/core"
			}
		},
		"copy-md": {
			"dependsOn": [
				"build"
			],
			"executor": "nx:run-commands",
			"outputs": [],
			"options": {
				"commands": [
					"rsync -rat packages/core/*.md build/packages/vctrl/core/"
				]
			}
		}
	}
}
