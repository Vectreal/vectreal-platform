{
	"$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
	"name": "io.github.Vectreal/vectreal",
	"title": "Vectreal",
	"description": "Upload, publish and embed 3D models on any website from your agent.",
	"websiteUrl": "https://vectreal.com/docs/agents",
	"repository": {
		"url": "https://github.com/Vectreal/vectreal-platform",
		"source": "github",
		"subfolder": "packages/cli"
	},
	"version": "3.2.0",
	"packages": [
		{
			"registryType": "npm",
			"identifier": "@vctrl/cli",
			"version": "3.2.0",
			"transport": {
				"type": "stdio"
			},
			"packageArguments": [
				{
					"type": "positional",
					"value": "mcp"
				}
			]
		}
	]
}
