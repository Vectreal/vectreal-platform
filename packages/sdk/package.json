{
	"name": "@vctrl/sdk",
	"version": "3.0.0",
	"description": "Typed client and zod schemas for Vectreal's agent API (/api/v1): projects, scenes, settings, publishing and embeds.",
	"bugs": {
		"url": "https://github.com/Vectreal/vectreal-platform/issues"
	},
	"homepage": "https://vectreal.com/docs/agents/api",
	"keywords": [
		"vectreal",
		"3d",
		"api",
		"sdk",
		"agent",
		"mcp",
		"gltf",
		"glb"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Vectreal/vectreal-platform.git"
	},
	"license": "AGPL-3.0-only",
	"type": "module",
	"sideEffects": false,
	"main": "./index.js",
	"types": "./index.d.ts",
	"publishConfig": {
		"access": "public",
		"directory": "../../build/packages/vctrl/sdk"
	},
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		}
	},
	"dependencies": {
		"zod": "catalog:"
	}
}
