{
	"version": "1.0.0",
	"name": "@vctrl/core",
	"description": "vctrl/core is the foundational package providing isomorphic 3D model processing capabilities. It contains the core classes for loading, optimizing, and exporting 3D models using glTF-Transform and Three.js, and runs in Node.js, browsers and Web Workers alike.",
	"bugs": {
		"url": "https://github.com/Vectreal/vectreal-platform/issues"
	},
	"homepage": "https://vectreal.com",
	"keywords": [
		"vectreal",
		"3d",
		"model",
		"gltf",
		"glb",
		"usdz",
		"optimization",
		"three",
		"isomorphic",
		"node",
		"gltf-transform"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Vectreal/vectreal-platform.git"
	},
	"license": "AGPL-3.0-only",
	"types": "./index.d.ts",
	"main": "./index.cjs.js",
	"module": "./index.es.js",
	"type": "module",
	"sideEffects": false,
	"publishConfig": {
		"access": "public",
		"directory": "../../build/packages/vctrl/core"
	},
	"exports": {
		".": {
			"types": "./index.d.ts",
			"import": "./index.es.js",
			"require": "./index.cjs.js"
		},
		"./model-loader": {
			"types": "./model-loader/index.d.ts",
			"import": "./model-loader.es.js",
			"require": "./model-loader.cjs.js"
		},
		"./model-optimizer": {
			"types": "./model-optimizer/index.d.ts",
			"import": "./model-optimizer.es.js",
			"require": "./model-optimizer.cjs.js"
		},
		"./model-exporter": {
			"types": "./model-exporter/index.d.ts",
			"import": "./model-exporter.es.js",
			"require": "./model-exporter.cjs.js"
		}
	},
	"peerDependencies": {
		"@react-three/drei": "catalog:"
	},
	"peerDependenciesMeta": {
		"@react-three/drei": {
			"optional": true
		}
	},
	"dependencies": {
		"@gltf-transform/core": "catalog:",
		"@gltf-transform/extensions": "catalog:",
		"@gltf-transform/functions": "catalog:",
		"jszip": "catalog:",
		"meshoptimizer": "catalog:",
		"three": "catalog:"
	},
	"devDependencies": {
		"@nx/vite": "catalog:",
		"vite": "catalog:",
		"vite-plugin-dts": "catalog:"
	}
}
