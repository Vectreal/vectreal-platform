{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"outDir": "../../dist/out-tsc",
		"types": ["vitest/globals", "vitest/importMeta", "node"],
		"moduleResolution": "bundler",
		// vitest.config.ts imports the shared base by its real `.mts` path so Vite's
		// native config loader can resolve it; type-checking is noEmit here.
		"allowImportingTsExtensions": true
	},
	"exclude": [],
	"include": [
		"vitest.config.ts",
		"src/**/*.spec.ts",
		"src/test-support.ts",
		"src/**/*.d.ts"
	]
}
