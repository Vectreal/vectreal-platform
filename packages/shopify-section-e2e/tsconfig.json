{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "es2022",
		"lib": ["es2022", "dom", "dom.iterable"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"ignoreDeprecations": "6.0",
		"allowImportingTsExtensions": true
	},
	"include": ["src/*.ts", "tests/**/*.ts", "playwright.config.ts"]
}
