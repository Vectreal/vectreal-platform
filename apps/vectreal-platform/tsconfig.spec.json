{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"outDir": "../../dist/out-tsc",
		// See shared/utils/tsconfig.spec.json - the vitest configs import
		// ../../vitest.shared.mts by its real extension.
		"allowImportingTsExtensions": true,
		"lib": ["dom", "dom.iterable", "esnext"],
		"types": [
			"vitest/globals",
			"vitest/importMeta",
			"vite/client",
			"node",
			"@nx/react/typings/cssmodule.d.ts",
			"@nx/react/typings/image.d.ts"
		],
		"rootDirs": [".", "./.react-router/types"]
	},
	"include": [
		".react-router/types/+future.ts",
		"vite.config.ts",
		"vitest.config.ts",
		"vitest.integration.config.ts",
		"../../vitest.shared.mts",
		"app/**/*.spec.ts",
		"app/**/*.spec.tsx",
		"tests/**/*.ts",
		"tests/**/*.tsx"
	]
}
